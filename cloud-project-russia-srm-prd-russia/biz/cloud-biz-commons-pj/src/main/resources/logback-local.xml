<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<property value="30" name="maxHistory"/>
	<!--    <property value="${spring.profiles.active:-local}" name="environment"/>-->
	<springProperty name="environment" scope="context" source="spring.profiles.active" defaultValue="local"/>
	<springProperty name="logPath" scope="context" source="log.path" defaultValue="/apps/logs"/>
	<springProperty name="appModule" scope="context" source="spring.application.name"/>

	<property name="pattern" value="[%date{yyyy-MM-dd HH:mm:ss.SSS}] [%level] [${appModule}] [${environment}] [%tid] [%thread] [%logger:%line] %msg%n"/>
	<appender name="app" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${logPath}/${appModule}.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<!-- 按天回滚 daily -->
			<fileNamePattern>${logPath}/${appModule}.%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
			<MaxHistory>${maxHistory}</MaxHistory>
			<TimeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<MaxFileSize>100MB</MaxFileSize>
			</TimeBasedFileNamingAndTriggeringPolicy>
		</rollingPolicy>
		<encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
			<layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
				<pattern>${pattern}</pattern>
			</layout>
		</encoder>
	</appender>
	<appender name="console" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
			<layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
				<pattern>${pattern}</pattern>
			</layout>
			<charset>utf8</charset>
		</encoder>
	</appender>

	<logger name="org.flywaydb" level="DEBUG" additivity="false">
		<appender-ref ref="console"/>
		<appender-ref ref="app"/>
	</logger>

	<!--rootLogger是默认的logger-->
	<root level="INFO">
		<!--定义了两个appender，日志会通过往这两个appender里面写-->
		<appender-ref ref="console"/>
		<appender-ref ref="app"/>
	</root>
	<springProfile name="DEV">
		<logger name="com.apache.ibatis" level="DEBUG" additivity="false">
			<appender-ref ref="console"/>
		</logger>
	</springProfile>
</configuration>

