        </dependency>
        <dependency>
            <groupId>net.qiyuesuo.sdk</groupId>
            <artifactId>private-sdk</artifactId>
            <version>4.1.2</version>
        </dependency>
        <dependency>
            <groupId>com.gwm.eas</groupId>
            <artifactId>axis</artifactId>
            <version>1.0.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/axis-1.0.6.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.gwm.eas</groupId>
            <artifactId>commons-discovery-0.2</artifactId>
            <version>1.0.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/commons-discovery-0.2-1.0.6.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.gwm.eas</groupId>
            <artifactId>jaxrpc</artifactId>
            <version>1.0.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/jaxrpc-1.0.6.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.gwm.eas</groupId>
            <artifactId>wsdl4j</artifactId>
            <version>1.5.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/wsdl4j-1.5.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.gw</groupId>
            <artifactId>consumer-mq-spring-boot-starter</artifactId>
            <version>1.0.1-RELEASE</version>
        </dependency>
<!--        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>aspose-words</artifactId>
            <version>18.6.2</version>
        </dependency>-->
        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>aspose-words</artifactId>
            <version>15.5.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/com.aspose.words-15.5.0.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
            <resource>
                <directory>../../sql/sit</directory>
                <targetPath>db/migration/sit</targetPath>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <classifier>boot</classifier>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version> <!-- 使用适当的版本号 -->
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.midea.cloud.srm.biz.pj.BizApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>