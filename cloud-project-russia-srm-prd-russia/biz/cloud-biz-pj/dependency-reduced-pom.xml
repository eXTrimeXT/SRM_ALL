<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>cloud-biz</artifactId>
    <groupId>com.midea</groupId>
    <version>1.0-russia-PROJECT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>cloud-biz-pj</artifactId>
  <version>1.0-russia-SNAPSHOT</version>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <resource>
        <targetPath>db/migration/sit</targetPath>
        <directory>../../sql/sit</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <classifier>boot</classifier>
          <includeSystemScope>true</includeSystemScope>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.midea.cloud.srm.biz.pj.BizApplication</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>2.7.11</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>log4j-to-slf4j</artifactId>
          <groupId>org.apache.logging.log4j</groupId>
        </exclusion>
        <exclusion>
          <artifactId>spring-boot-test-autoconfigure</artifactId>
          <groupId>org.springframework.boot</groupId>
        </exclusion>
        <exclusion>
          <artifactId>json-path</artifactId>
          <groupId>com.jayway.jsonpath</groupId>
        </exclusion>
        <exclusion>
          <artifactId>assertj-core</artifactId>
          <groupId>org.assertj</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>mockito-core</artifactId>
          <groupId>org.mockito</groupId>
        </exclusion>
        <exclusion>
          <artifactId>mockito-junit-jupiter</artifactId>
          <groupId>org.mockito</groupId>
        </exclusion>
        <exclusion>
          <artifactId>jsonassert</artifactId>
          <groupId>org.skyscreamer</groupId>
        </exclusion>
        <exclusion>
          <artifactId>xmlunit-core</artifactId>
          <groupId>org.xmlunit</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.mideacloud</groupId>
      <artifactId>partner-client</artifactId>
      <version>1.0.8</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/partner-client-1.0.8.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.gwm.eas</groupId>
      <artifactId>axis</artifactId>
      <version>1.0.6</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/axis-1.0.6.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.gwm.eas</groupId>
      <artifactId>commons-discovery-0.2</artifactId>
      <version>1.0.6</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/commons-discovery-0.2-1.0.6.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.gwm.eas</groupId>
      <artifactId>jaxrpc</artifactId>
      <version>1.0.6</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/jaxrpc-1.0.6.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.gwm.eas</groupId>
      <artifactId>wsdl4j</artifactId>
      <version>1.5.1</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/wsdl4j-1.5.1.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.aspose</groupId>
      <artifactId>aspose-words</artifactId>
      <version>15.5.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/com.aspose.words-15.5.0.jar</systemPath>
    </dependency>
  </dependencies>
  <properties>
    <base.version>1.0.0</base.version>
    <mapstruct.version>1.5.3.Final</mapstruct.version>
  </properties>
</project>
