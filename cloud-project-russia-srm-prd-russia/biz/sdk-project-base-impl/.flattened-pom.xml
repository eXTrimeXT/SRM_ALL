<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.midea</groupId>
    <artifactId>sdk-project-impl</artifactId>
    <version>meiqing-V3.0.11.1</version>
  </parent>
  <groupId>com.midea</groupId>
  <artifactId>sdk-project-base-impl</artifactId>
  <version>meiqing-V3.0.11.1</version>
  <dependencies>
    <dependency>
      <groupId>com.midea</groupId>
      <artifactId>sdk-project-entity</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.midea</groupId>
      <artifactId>cloud-biz-base-extend</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.gwm</groupId>
      <artifactId>gwm-open-sdk</artifactId>
      <version>1.0.6</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/gwm-open-sdk-1.0.6.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.midea</groupId>
      <artifactId>sdk-mg-base-interface</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.midea</groupId>
      <artifactId>cloud-biz-api-pj</artifactId>
      <version>1.0-russia-SNAPSHOT</version>
      <exclusions>
        <exclusion>
          <groupId>com.googlecode.aviator</groupId>
          <artifactId>aviator</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.midea</groupId>
      <artifactId>cloud-biz-commons-pj</artifactId>
      <version>1.0-russia-SNAPSHOT</version>
      <exclusions>
        <exclusion>
          <groupId>com.googlecode.aviator</groupId>
          <artifactId>aviator</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <resource>
        <targetPath>../</targetPath>
        <directory>lib</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <resource>
        <targetPath>../sdk-project-entity</targetPath>
        <directory>../sdk-project-entity/target/classes/</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.1.2</version>
        <executions>
          <execution>
            <id>unpack</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.midea</groupId>
                  <artifactId>sdk-project-entity</artifactId>
                  <version>${project.version}</version>
                  <overWrite>false</overWrite>
                  <outputDirectory>${project.build.directory}/classes</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.midea</groupId>
                  <artifactId>cloud-biz-api-pj</artifactId>
                  <version>1.0-russia-SNAPSHOT</version>
                  <overWrite>false</overWrite>
                  <outputDirectory>${project.build.directory}/classes</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.midea</groupId>
                  <artifactId>cloud-biz-commons-pj</artifactId>
                  <version>1.0-russia-SNAPSHOT</version>
                  <overWrite>false</overWrite>
                  <outputDirectory>${project.build.directory}/classes</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
