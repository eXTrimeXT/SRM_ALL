{
  "name": "srm",
  "version": "2.1.7",
  "description": "",
  "author": "meizhen.zhao@meicloud.com",
  "scripts": {
    "test:unit": "jest --clearCache && vue-cli-service test:unit",
    "lint": "eslint .",
    "copyToProject": "node copyToProject.js",
    "cleanAndCopy": "node cleanAndCopyFile.js",
    "cleanAndCopyFileSup": "node cleanAndCopyFileSupplier.js",
    "dev": "vite",
    "buyer": "cross-env VUE_APP_MODEL=buyer vite",
    "supplier": "cross-env VUE_APP_MODEL=supplier vite",
    "build:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode dev && npm run cleanAndCopy",
    "build:sit": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode sit && npm run cleanAndCopy",
    "build:sitdemo": "cross-env VUE_APP_LOGO_TYPE=style2 NODE_OPTIONS=--max-old-space-size=8192 vite build --mode sit && npm run cleanAndCopy",
    "build:uat": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode uat && npm run cleanAndCopy",
    "build:prod": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode production && npm run cleanAndCopy",
    "build:buyer:dev": "cross-env VUE_APP_MODEL=buyer NODE_OPTIONS=--max-old-space-size=8192 vite build --mode dev && npm run cleanAndCopy",
    "build:buyer:sit": "cross-env VUE_APP_MODEL=buyer NODE_OPTIONS=--max-old-space-size=8192 vite build --mode sit && npm run cleanAndCopy",
    "build:buyer:uat": "cross-env VUE_APP_MODEL=buyer NODE_OPTIONS=--max-old-space-size=8192 vite build --mode uat && npm run cleanAndCopy",
    "build:buyer:prod": "cross-env VUE_APP_MODEL=buyer NODE_OPTIONS=--max-old-space-size=8192 vite build --mode production && npm run cleanAndCopy",
    "build:supplier:dev": "cross-env VUE_APP_MODEL=supplier NODE_OPTIONS=--max-old-space-size=8192 vite build --mode dev && npm run cleanAndCopyFileSup",
    "build:supplier:sit": "cross-env VUE_APP_MODEL=supplier NODE_OPTIONS=--max-old-space-size=8192 vite build --mode sit && npm run cleanAndCopyFileSup",
    "build:supplier:uat": "cross-env VUE_APP_MODEL=supplier NODE_OPTIONS=--max-old-space-size=8192 vite build --mode uat && npm run cleanAndCopyFileSup",
    "build:supplier:prod": "cross-env VUE_APP_MODEL=supplier NODE_OPTIONS=--max-old-space-size=8192 vite build --mode production && npm run cleanAndCopyFileSup",
    "build:report": "vite build --mode sit --report",
    "build:stage": "vite build --mode staging",
    "new": "plop",
    "preview": "node build/index.js --preview",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml",
    "test:ci": "npm run lint && npm run test:unit",
    "fix-memory-limit": "cross-env LIMIT=4096 increase-memory-limit",
    "prepare": "node scripts/pre-build-vue-json-editor.js"
  },
  "dependencies": {
