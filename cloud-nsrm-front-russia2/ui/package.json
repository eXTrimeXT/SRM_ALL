    "eslint": "^5.16.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-vue": "^5.2.3",
    "fs-extra": "^9.1.0",
    "husky": "1.3.1",
    "increase-memory-limit": "^1.0.7",
    "jsonlint": "1.6.3",
