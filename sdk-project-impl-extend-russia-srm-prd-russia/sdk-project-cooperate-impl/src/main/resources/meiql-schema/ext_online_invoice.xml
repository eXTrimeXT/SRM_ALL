<meiql _version="1.0" _type="custom">
    <type name="OnlineInvoice,OnlineInvoiceVendor">
        <validators>
            <action name="saveOrUpdate">
                <validator type="request" range="list" msg="参数缺失">
                    return ql.notEmpty($recs);
                </validator>
                <validator type="request" msg="仅支持一条数据">
                    return count($recs) == 1;
                </validator>
                <validator type="request" msg="开票类型不能为空">
                    return ql.notEmpty($rec["onlineInvoiceType"]);
                </validator>
                <validator type="request" msg="单据状态不能为空">
                    return ql.notEmpty($rec["invoiceStatus"]);
                </validator>
                <validator type="request" msg="传参状态错误">
                    return ql.in($rec["invoiceStatus"], "DRAFT", "FINAL_REVIEW_APPROVED");
                </validator>
                <validator type="request" msg="供应商不能为空">
                    return ql.notEmpty($rec["vendorCode"]) &amp;&amp; ql.notNull($rec["vendorId"]) &amp;&amp; ql.notEmpty($rec["vendorName"]);
                </validator>
                <validator type="request" msg="业务实体不能为空">
                    return ql.notEmpty($rec["orgCode"]) &amp;&amp; ql.notNull($rec["orgId"]) &amp;&amp; ql.notEmpty($rec["orgName"]);
                </validator>
                <validator type="request" msg="库存组织不能为空">
                    return ql.notEmpty($rec["organizationCode"]) &amp;&amp; ql.notNull($rec["organizationId"]) &amp;&amp; ql.notEmpty($rec["organizationName"]);
                </validator>
                <validator type="request" msg="对账单明细不能为空">
                    return ql.notEmpty(ql.clearDel($rec["detailList"]));
                </validator>
                <validator type="request" msg="发票明细不能为空">
                    return ql.notEmpty(ql.clearDel($rec["ocrInvoiceList"]));
                </validator>
                <validator type="request" msg="只有单据为[拟定]状态才能修改">
                    if (ql.notNull($rec["onlineInvoiceId"])) {
                    c = ql.newCond();
                    ql.cond.eq(c,"onlineInvoiceId",$rec["onlineInvoiceId"]);
                    r = ql.query("OnlineInvoice",c);
                    return ql.notEmpty(r) &amp;&amp; (r[0]["invoiceStatus"] == "DRAFT");
                    }
                    return true;
                </validator>
            </action>

            <action name="delete">
                <validator type="request" range="list" msg="参数缺失">
                    return ql.notEmpty($recs);
                </validator>
                <validator type="request" msg="单据id不能为空">
                    return ql.notEmpty($rec["onlineInvoiceId"]);
                </validator>
                <validator type="db" range="list" msg="单据不存在">
                    return ql.notEmpty($recs);
                </validator>
                <validator type="db" msg="单据状态不为[拟定]，请检查!">
                    return $rec["invoiceStatus"] == "DRAFT";
                </validator>
            </action>

        </validators>
    </type>

    <type name="OnlineInvoiceDetail,OnlineInvoiceDetailVendor">
        <validators>
            <action name="create,update">
                <validator type="request" msg="本次开票数量必须大于0">
                    return ql.notNull($rec["invoiceQuantity"]) &amp;&amp; ql.gt($rec["invoiceQuantity"], 0);
                </validator>
            </action>
        </validators>
    </type>

    <type name="OnlineInvoiceAdvanceApply,OnlineInvoiceAdvanceApplyVendor">
        <validators>
            <action name="create,update">
                <validator type="request" msg="开票单预付款明细未核销金额必须大于0">
                    return ql.notNull($rec["unWrittenOffAmount"]) &amp;&amp; ql.ge($rec["unWrittenOffAmount"], 0);
                </validator>
                <validator type="request" msg="开票单预付款明细本次核销金额必须大于0">
                    return ql.notNull($rec["curWrittenOffAmount"]) &amp;&amp; ql.ge($rec["curWrittenOffAmount"], 0);
                </validator>
                <validator type="request" msg="开票单预付款明细本次核销金额不能大于未核销金额">
                    return ql.ge($rec["unWrittenOffAmount"], $rec["curWrittenOffAmount"]);
                </validator>
            </action>
        </validators>
    </type>

    <type name="OnlineInvoiceOcrInvoice,OnlineInvoiceOcrInvoiceVendor">
        <validators>
            <action name="create,update">
                <validator type="request" msg="请检查发票明细行，存在税率不一致">
                    if ($pRec["invoiceStatus"] == "SUBMITTED" || $pRec["invoiceStatus"] == "VENDOR_SUBMITTED") {
                    return $rec["commodityTaxRate"] == $pRec["taxRate"];
                    }
                    return true;
                </validator>
                <validator type="request" msg="发票信息的供方与供应商名称不一致">
                    if ($pRec["invoiceStatus"] == "SUBMITTED" || $pRec["invoiceStatus"] == "VENDOR_SUBMITTED") {
                    return $rec["sellerName"] == $pRec["vendorName"];
                    }
                    return true;
                </validator>
            </action>
        </validators>
    </type>
</meiql>