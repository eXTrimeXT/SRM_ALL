<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.midea.cloud.srm.perf.orderscoreman.mapper.PjOrderScoreManScoringV1Mapper">

    <select id="listByGroupList" resultType="com.midea.cloud.srm.model.perf.orderscoreman.entity.PjOrderScoreManScoringV1">
        select * from scc_perf_score_man_scoring_v1
        where (SCORE_ITEMS_ID,COMPANY_ID,SCORE_USER_NAME,CATEGORY_ID) in
        <foreach collection="list" item="item" open="(" close=")" separator=",">
            (#{item.scoreItemsId},#{item.companyId},#{item.scoreUserName},#{item.categoryId})
        </foreach>
    </select>
    <select id="listCheckDetailByGroupList" resultType="com.midea.cloud.srm.model.perf.ordercheck.entity.PerfScoreItemsOrderCheckDetail">
        select ocd.*,snsioc.SCORE_ITEMS_ID,snsioc.COMPANY_ID
        from scc_npm_score_item_order_check_detail ocd
                 left join scc_npm_score_item_order_check snsioc on ocd.ORDER_CHECK_ID = snsioc.ORDER_CHECK_ID
        where (snsioc.SCORE_ITEMS_ID,snsioc.COMPANY_ID,ocd.SCORE_USER_NAME,ocd.CATEGORY_ID) in
        <foreach collection="list" item="item" open="(" close=")" separator=",">
            (#{item.scoreItemsId},#{item.companyId},#{item.scoreUserName},#{item.categoryId})
        </foreach>
    </select>


</mapper>