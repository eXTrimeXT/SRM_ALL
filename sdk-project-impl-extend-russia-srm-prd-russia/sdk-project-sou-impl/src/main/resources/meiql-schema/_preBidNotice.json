{
  "_version": "1.0",
  "_type": "base",
  "PreBidNoticeFields": {
    "keyField": "bidNoticeId",
    "fields": {
      "bidNoticeId": "Long:主键",
      "bidNoticeNo":  {
        "convert": "seqGen:BID_NOTICE_NO",
        "desc": "标前交流通知单号"
      },
      "bidNoticeTitle": "String:标前交流通知单标题",
      "requirementHeadId": "Long:申请单ID",
      "requirementHeadNo": "String:申请单号",
      "projectName": "String:项目名称",
      "orgBuId": "Long:板块ID",
      "orgBuCode": "String:板块编码",
      "orgBuName": "String:板块名称",
      "orgId": "Long:公司ID(对应产品的业务实体id)",
      "orgCode": "String:公司编码(对应产品的业务实体编码)",
      "orgName": "String:公司名称(对应产品的业务实体名称)",
      "demandDepartmentId": "String:需求部门ID",
      "demandDepartmentCode": "String:需求部门编码",
      "demandDepartmentName": "String:需求部门名称",
      "status": "String:单据状态",
      "demandUserId": "String:需求人id(跟申请单保持类型一致)",
      "demandUserName": "String:需求人工号",
      "demandUserNickname": "String:需求人名称",
      "vendorUserId": "Long:供应商负责人用户ID",
      "vendorUserNickname": "String:供应商负责人用户名称",
      "vendorUserPhone": "String:供应商负责人联系电话",
      "vendorUserOfficePhone": "String:供应商负责人办公电话",
      "bidUserId": "Long:招标负责人用户ID",
      "bidUserNickname": "String:招标负责人用户名称",
      "remark": "String:备注",
      "@include": ":BaseFields"
    }
  },
  "PreBidNoticeVendorFields": {
    "keyField": "bidNoticeVendorId",
    "fields": {
      "bidNoticeVendorId": "Long:主键",
      "bidNoticeId": "Long:标前交流通知表主键",
      "vendorId": "Long:供应商id",
      "vendorCode": "String:供应商编码/企业标识",
      "vendorName": "String:供应商名称",
      "contactName": "String:报名联系人",
      "vendorAttribute": "String:供应商属性",
      "phone": "String:报名联系手机号",
      "@include": ":BaseFields"
    }
  }
}
