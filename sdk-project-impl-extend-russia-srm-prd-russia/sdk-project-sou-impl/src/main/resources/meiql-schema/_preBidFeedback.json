{
  "_version": "1.0",
  "_type": "base",
  "PreBidFeedbackFields": {
    "keyField": "bidFeedbackId",
    "fields": {
      "bidFeedbackId": "Long:主键",
      "bidFeedbackNo": {
        "convert": "seqGen:BID_FEEDBACK_NO",
        "desc": "标前交流反馈单号"
      },
      "bidNoticeId": "Long:标前交流通知主键",
      "bidNoticeNo": "String:标前交流通知单号",
      "bidNoticeTitle": "String:标前交流通知单标题",
      "projectName": "String:项目名称",
      "orgBuId": "Long:板块ID",
      "orgBuCode": "String:板块编码",
      "orgBuName": "String:板块名称",
      "orgId": "Long:公司ID(对应产品的业务实体id)",
      "orgCode": "String:公司编码(对应产品的业务实体编码)",
      "orgName": "String:公司名称(对应产品的业务实体名称)",
      "demandDepartmentId": "String:需求部门ID",
      "demandDepartmentCode": "String:需求部门编码",
      "demandDepartmentName": "String:需求部门名称",
      "status": "String:单据状态",
      "demandUserId": "String:需求人id(跟申请单保持类型一致)",
      "demandUserName": "String:需求人工号",
      "demandUserNickname": "String:需求人名称",
      "vendorUserId": "Long:供应商负责人用户ID",
      "vendorUserNickname": "String:供应商负责人用户名称",
      "vendorUserPhone": "String:供应商负责人联系电话",
      "vendorUserOfficePhone": "String:供应商负责人办公电话",
      "remark": "String:备注",
      "@include": ":BaseFields",
      "vendorId": {
        "type": "Long",
        "desc": "供应商ID",
        "virtual": true
      }
    }
  },
  "PreBidFeedbackVendorFields": {
    "keyField": "bidFeedbackVendorId",
    "fields": {
      "bidFeedbackVendorId": "Long:主键",
      "bidFeedbackId": "Long:标前交流通知表主键",
      "vendorId": "Long:供应商id",
      "vendorCode": "String:供应商编码/企业标识",
      "vendorName": "String:供应商名称",
      "contactName": "String:报名联系人",
      "vendorAttribute": "String:供应商属性",
      "phone": "String:报名联系手机号",
      "sourceDescription": "String:来源说明",
      "feedbackStatus": "String:反馈状态",
      "rejectDescription": "String:驳回说明",
      "isSelected": "String:是否入围（Y是，N否）",
      "@include": ":BaseFields"
    }
  },
  "PreBidBackAttachFields": {
    "keyField": "backAttachId",
    "fields": {
      "backAttachId": "Long:ID",
      "bidFeedbackId": "Long:标前反馈单ID",
      "fileType": "String:文件类型",
      "fileId": "Long:文件ID",
      "fileName": "String:文件名称",
      "remark": "String:附件备注",
      "sortIndex": "Integer:排序",
      "vendorId": "Long:供应商id",
      "vendorCode": "String:供应商编码/企业标识",
      "vendorName": "String:供应商名称",
      "@include": ":BaseFields"
    }
  }
}
